<Project>
  <Import Project="..\WorkspaceTplQueue\Directory.Build.targets" Condition="Exists('..\WorkspaceTplQueue\Directory.Build.targets') and '$(SolutionFileName)' == 'WorkspaceTplQueue.sln'" />
  <Target Name="PackLocalAfterSolutionBuild" AfterTargets="Build" Condition="'$(SkipPackLocal)' != 'true' and '$(SolutionFileName)' == 'Fmacias.TplQueue.Abstractions.sln' and '$(MSBuildProjectName)' == 'Fmacias.TplQueue.Abstractions'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)pack-local.ps1&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>

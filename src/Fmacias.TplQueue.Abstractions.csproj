<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Target: contracts should be usable from old and new runtimes -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<!-- NuGet identity -->
		<PackageId>Fmacias.TplQueue.Abstractions</PackageId>
		<Version>$(TplQueueVersion)</Version>
		<AssemblyName>Fmacias.TplQueue.Abstractions</AssemblyName>
		<RootNamespace>Fmacias.TplQueue</RootNamespace>

		<!-- Package metadata -->
		<Authors>Fernando Macías Ruano</Authors>
		<Company>Fernando Macías Ruano</Company>
		<Product>TplQueue.Abstractions</Product>
		<Description>Public contracts and shared models for TplQueue jobs, queues, retry policies, observers, payload handling, cache hydration, and serializer integration.</Description>
		<PackageTags>tplqueue;job;queue;concurrency;retry;observer;payload;cache;netstandard</PackageTags>
		<RepositoryUrl>https://github.com/fmacias/TplQueue.Abstractions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/fmacias/TplQueue.Abstractions</PackageProjectUrl>

		<!-- License: MIT for abstractions -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<Copyright>Copyright (c) Fernando Macías Ruano 2026</Copyright>

		<!-- Package README shown on nuget.org -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Optional: don't pack on every build; we pack explicitly -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Include symbols / SourceLink if you want better debugging experience -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Optional: mark as packable explicitly (default true, but explicit is clear) -->
		<IsPackable>true</IsPackable>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Contracts\CacheCancelMode.cs" />
	  <Compile Remove="Contracts\IBoundArgumentsProvider.cs" />
	  <Compile Remove="Contracts\IHandlerCatalog.cs" />
	  <Compile Remove="Contracts\IPayloadJobFactory1.cs" />
	  <Compile Remove="Contracts\IPayloadQueueCache.cs" />
	  <Compile Remove="Contracts\ISerializablePayloadGraphConverterProvider.cs" />
	  <Compile Remove="Contracts\ISerializableRunnerRoot.cs" />
	  <Compile Remove="Contracts\ISerializationJobNodeAttributes.cs" />
	  <Compile Remove="Contracts\ISerializedPayloadFactory.cs" />
	  <Compile Remove="Contracts\ITaskBufferStore.cs" />
	  <Compile Remove="Contracts\IUniversaDtoHandler.cs" />
	  <Compile Remove="ISerializableRunner.cs" />
	  <Compile Remove="NodeState.cs" />
	  <Compile Remove="RetryPolicyDescriptor.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="NuGet.config" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
		<PackageReference Include="System.Text.Json" Version="10.0.0" />
	</ItemGroup>
</Project>
